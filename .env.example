# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的大模型_API_KEY
LLM_QWEN_MAX=qwen-max

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
TAVILY_API_KEY=你的_TAVILY_API_KEY

# RAGFlow 配置
RAGFLOW_API_URL=http://your-ragflow-host
RAGFLOW_API_KEY=ragflow-your-api-key

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL

# Redis 缓存配置（项目 1）
# 是否启用 Redis 缓存，默认 false（关闭状态下系统正常运行，不依赖 Redis）
REDIS_ENABLED=false
# Redis 连接 URL，支持 redis://host:port/db 格式
REDIS_URL=redis://localhost:6379/0
# 搜索结果缓存过期时间（秒），默认 3600 秒（1 小时）
SEARCH_CACHE_TTL=3600

# 安全防护配置（项目 2）
# SQL 表名白名单（逗号分隔），空值表示不限制，建议生产环境配置
ALLOWED_SQL_TABLES=
# SQL 查询超时时间（秒），防止长时间查询占用资源
SQL_QUERY_TIMEOUT=5
# 单次 SQL 查询最大返回行数，防止大结果集占用内存
SQL_MAX_ROWS=100
# 单个上传文件最大大小（MB），防止大文件攻击
MAX_UPLOAD_MB=20
# 允许上传的文件扩展名白名单（逗号分隔，需包含点号）
ALLOWED_FILE_EXTENSIONS=.txt,.md,.pdf,.docx,.xlsx,.csv

# LangSmith 可观测性配置（项目 3）
# LangSmith API 密钥（从 https://smith.langchain.com 获取）
LANGSMITH_API_KEY=
# 启用 tracing，设置为 true 或 v1 开启，空值表示关闭（关闭时不影响系统运行）
LANGSMITH_TRACING=
# Trace 提供商，默认 langsmith（预留扩展到其他 tracing 系统）
TRACING_PROVIDER=langsmith

# 会话持久化配置（项目 4）
# SQLite 数据库文件路径（相对于项目根目录）
CHECKPOINT_DB_PATH=app/data/checkpoints.db
# 会话过期天数（清理策略），默认 30 天
SESSION_EXPIRE_DAYS=30
